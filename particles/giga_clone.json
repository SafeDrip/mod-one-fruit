{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:giga_clone",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 25
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 1.8, 0],
				"half_dimensions": [0.5, 2, 0.5],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = 0.75 * math.pow(1.0-(variable.particle_age / variable.particle_lifetime), 0.08);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": "Math.random(0.25, 0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.2, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "Math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "variable.particle_age > 1",
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age",
					"gradient": {
						"0.0": "#FF7A7A7A",
						"1.0": "#00BDBDBD"
					}
				}
			}
		}
	}
}