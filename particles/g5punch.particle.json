					"texture_width": 16,
					"texture_height": 16,
					"uv": [11, 10],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFAD1D1D",
						"0.46": "#FFFF1F1F",
						"1.0": "#00000000"
					}
				}
			}
