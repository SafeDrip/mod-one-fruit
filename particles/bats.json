{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:bats",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/bat"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 3,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "Math.random(0,9)"
			},
			"minecraft:particle_initial_speed": "Math.random(5,9)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 1, 0],
				"linear_drag_coefficient": 2.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.01+variable.particle_age*0.55", "0.01+variable.particle_age*0.55"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 64,
					"uv": [0, 0],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "0.01+variable.particle_age",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.4": "#CCFFFFFF",
						"1.1": "#FFFFFFFF",
						"1.7": "#C7C1D9FF",
						"2.0": "#00FFFFFF"
					}
				}
			}
		}
