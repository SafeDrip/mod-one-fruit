{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:fenix_meteor",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/fenix"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10,
				"max_particles": 20
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"radius": 5,
				"direction": ["Math.random(-0.1, 0.1)", "Math.random(0.1, 1.0)", "Math.random(-0.1, 0.1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_initial_speed": "Math.random(8.0, 16.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1 * 5.0 - 2.5)", -10, "(variable.particle_random_1 * 5.0 - 2.5)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(variable.particle_random_3 * 0.5 + 0.75) * (1 - Math.pow((variable.particle_age + query.frame_alpha) / variable.particle_lifetime, 2))", "(variable.particle_random_3 * 0.5 + 0.75) * (1 - Math.pow((variable.particle_age + query.frame_alpha) / variable.particle_lifetime, 2))"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 1280,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [128, 128],
						"step_UV": [0, 130],
						"frames_per_second": 4,
						"max_frame": 15,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 100,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age",
					"gradient": {
						"0.0": "#ffffffff",
						"0.21": "#FF50DDE3",
						"1.0": "#EBFFFFFF"
					}
				}
			}
		}
	}
}