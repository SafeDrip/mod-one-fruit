{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:chestshadow",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.5;variable.lifetime = 1;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 25
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": [0.4, 0.05, 0.15],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_1+0.5"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.random(1,30)", 0],
				"linear_drag_coefficient": "math.random(1,2)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)-0.2", "variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)+2.5"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 127,
					"uv": [1, 1],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.0": "#85000000",
						"0.6": "#B0000000",
						"1.0": "#00D01FFF"
					}
				}
			}
		}
	}
}