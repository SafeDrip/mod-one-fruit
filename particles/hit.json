{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:hit",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/hit"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.01+variable.particle_age*3", "0.01+variable.particle_age*3"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 384,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [128, 128],
						"step_UV": [0, 128],
						"frames_per_second": 4,
						"max_frame": 10
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "0.01+variable.particle_age",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.08": "#CCFFFFFF",
						"0.19": "#FFFFFFFF",
						"0.33": "#C7F7C4C4",
						"0.5": "#00FFFFFF"
					}
				}
			}
		}
	}
}
