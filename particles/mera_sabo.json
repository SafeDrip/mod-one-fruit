{ 	"format_version": "1.10.0", 	"particle_effect": { 		"description": { 			"identifier": "of:mera_sabo", 			"basic_render_parameters": { 				"material": "particles_blend", 				"texture": "textures/particle/sabo_flame" 			} 		}, 		"components": { 			"minecraft:emitter_rate_instant": { 				"num_particles": 15 			}, 			"minecraft:emitter_lifetime_once": { 				"active_time": 1 			}, 			"minecraft:emitter_shape_sphere": { 				"radius": 1, 				"direction": "outwards" 			}, 			"minecraft:particle_lifetime_expression": { 				"max_lifetime": "Math.random(5,10)" 			}, 			"minecraft:particle_initial_speed": 2, 			"minecraft:particle_motion_dynamic": { 				"linear_acceleration": [0, 5, 0], 				"linear_drag_coefficient": 2.5 			}, 			"minecraft:particle_appearance_billboard": { 				"size": ["variable.particle_random_1 * variable.particle_random_2 * 1.2 + 0.2", "variable.particle_random_1 * variable.particle_random_2 * 1.2 + 0.2"], 				"facing_camera_mode": "lookat_xyz", 				"uv": { 					"texture_width": 64, 					"texture_height": 256, 					"flipbook": { 						"base_UV": [0, 8], 						"size_UV": [128, 128], 						"step_UV": [0, 64], 						"frames_per_second": 30, 						"max_frame": 30, 						"stretch_to_lifetime": true, 						"loop": true 					} 				} 			}, 			"minecraft:particle_appearance_lighting": {}, 			"minecraft:particle_appearance_tinting": { 				"color": { 					"interpolant": "v.particle_age", 					"gradient": { 						"0.0": "#ffffffff", 						"0.98": "#00FFFFFF" 					} 				} 			} 		} 	} }