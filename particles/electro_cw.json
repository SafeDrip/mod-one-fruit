				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [40, 80],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_3",
					"gradient": {
						"0.0": "#FFFFFFFF",
