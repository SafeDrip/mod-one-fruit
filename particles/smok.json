{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:smok",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 40
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": 1,
				"rotation_rate": 2
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["Math.cos((variable.particle_age * 360) + (variable.particle_random_1 * 360))", "variable.particle_age*20", "Math.sin((variable.particle_age * 960) + (variable.particle_random_1 * 60))"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [2, 2],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 80],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 1,
						"max_frame": 16,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.81": "#FF5B5B5B"
					}
				}
			}
		}
