			"minecraft:particle_initial_speed": "math.random(0,2)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.random(0.1,1)", 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_random_1*0.3)+0.15-v.particle_age*0.1", "(v.particle_random_1*0.3)+0.15-v.particle_age*0.1"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [0, 32],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_1",
					"gradient": {
						"0.0": "#ffffffff",
						"0.16": "#FFFF0000",
						"0.29": "#FFFFD000",
						"0.41": "#FF01FF18",
						"0.53": "#FF00FFC6",
						"0.67": "#FF020DFF",
						"0.82": "#FFD400FF",
						"1.0": "#FFFF00A7"
