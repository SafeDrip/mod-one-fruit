{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:leg_ex",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0.1, 0],
				"radius": 0.1,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": "Math.random(5.0,8.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1)", "math.random((5 - variable.particle_age * 25),(10 - variable.particle_age * 35))", "(variable.particle_random_2)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.05 + variable.particle_random_1*0.05)", "(0.05 + variable.particle_random_1*0.05)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 24],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 1,
						"max_frame": 2
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 100,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.0": "#FFFFE100",
						"0.3": "#FFFFFFFF",
						"1.0": "#00FFFC00"
					}
				}
			}
		}
	}
}