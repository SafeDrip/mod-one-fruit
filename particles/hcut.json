{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "of:hcut",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/haki_king"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 25
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.25
			},
			"minecraft:particle_initial_spin": {
				"rotation": "Math.random(1,999)"
			},
			"minecraft:particle_initial_speed": "Math.random(1,2)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["1 - (variable.particle_age * 1.25)", "1 - (variable.particle_age * 1.25)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 1280,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [128, 128],
						"step_UV": ["1 - (variable.particle_random_1 * 10)", 128],
						"frames_per_second": 8,
						"max_frame": 10,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.38": "#FFFFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}
