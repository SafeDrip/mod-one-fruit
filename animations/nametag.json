{
	"format_version": "1.8.0",
	"animations": {
		"animation.nametag": {
			"loop": true,
			"animation_length": 0.5,
			"override_previous_animation": true,
			"bones": {
           "nametag": {
             "rotation": [
                 "query.camera_rotation(0)",
                 "query.is_in_ui ? -180 : query.camera_rotation(1) - query.body_y_rotation",
                 0
               ],
             "scale": "query.is_in_ui ? 0 : 1"
           }
			}
		}
	}
}
