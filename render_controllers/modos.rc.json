{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.amaru_dragon": {
      "geometry": "Geometry.amaru_dragon",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.amaru_dragon" ]
    },

    "controller.render.candy_armor": {
      "geometry": "Geometry.custom",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.candy_armor" ],
      "part_visibility": [
        { "*": "!v.is_first_person" },
        { "RightArm": true },
        { "RightArmD": true },
        { "LeftArm": true },
        { "LeftArmD": true }
      ]
    },

    "controller.render.cyberx": {
      "geometry": "Geometry.cyberx",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.cyberx" ],
      "part_visibility": [
        { "*": true },
        { "head": "!variable.is_first_person" },
        { "RightArm": "(!variable.is_first_person && query.get_equipped_item_name(0, 1) != 'gear5_grab' && query.get_equipped_item_name(0, 1) != 'punk_vice_v2') || (variable.is_first_person && (query.equipped_item_any_tag('slot.weapon.mainhand','hand') || variable.sword_f1 || variable.sword_f2 || variable.sword_f3 || variable.sword_f4 || variable.sword_f5 || query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'map'))" },
        { "RightArmD": "(!variable.is_first_person && query.get_equipped_item_name(0, 1) != 'gear5_grab' && query.get_equipped_item_name(0, 1) != 'punk_vice_v2') || (variable.is_first_person && (query.equipped_item_any_tag('slot.weapon.mainhand','hand') || variable.sword_f1 || variable.sword_f2 || variable.sword_f3 || variable.sword_f4 || variable.sword_f5 || query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'map'))" },
        { "LeftArm": "(!variable.is_first_person && query.get_equipped_item_name(0, 1) != 'punk_vice_v2') || (variable.is_first_person && (query.equipped_item_any_tag('slot.weapon.mainhand','hand2') || variable.sword_f1 || variable.sword_f2 || variable.sword_f3 || variable.sword_f4 || variable.sword_f5 || query.get_equipped_item_name(0, 1) == ''))" },
        { "LeftArmD": "(!variable.is_first_person && query.get_equipped_item_name(0, 1) != 'punk_vice_v2') || (variable.is_first_person && (query.equipped_item_any_tag('slot.weapon.mainhand','hand2') || variable.sword_f1 || variable.sword_f2 || variable.sword_f3 || variable.sword_f4 || variable.sword_f5 || query.get_equipped_item_name(0, 1) == ''))" }
      ]
    },

    "controller.render.tree": {
      "geometry": "Geometry.tree",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.tree" ]
    },

    "controller.render.death": {
      "geometry": "Geometry.death",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.death" ],
      "part_visibility": [
        { "*": "query.variant != 600" }
      ]
    },

