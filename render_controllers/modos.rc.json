    "controller.render.pteranodon": {
      "arrays": {
        "textures": {
          "array.ani": [
            "texture.pteranodon_1",
            "texture.pteranodon_2",
            "texture.pteranodon_3",
            "texture.pteranodon_4"
          ]
        }
      },
      "geometry": "Geometry.pteranodon",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "temp.life_time = query.life_time * 10.0; return array.ani[temp.life_time];" ]
    },

    "controller.render.pteranodonh": {
