{
  "format_version": "1.16.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "of:giga_clone",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/giga_stone"
      },
      "geometry": {
        "default": "geometry.sulong",
        "dmg": "geometry.dmg"
      },
     "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.attack = Math.sin(variable.attack_time * 90.0);",
          "variable.health = math.round(query.health / query.max_health * 22);"
        ],
        "animate":[
          "look_at_target_controller",
          "move_controller",
          "mob_controller",
          "swimming_controller",
          "default",
          "dmg",
          "c.spawn"
        ],
        "variables": {
          "variable.hp": "public"
        },
        "initialize": [
          "variable.hp = query.health;"
        ]
      },
      "animations": {
        "default": "controller.animation.mob.general3",
        "mob_controller": "controller.animation.mobattack",
        "c.spawn": "controller.animation.spawn",
        "spawn": "animation.giga_clone.spawn",
        "atk1": "animation.mobattack1",
        "atk2": "animation.mobattack2",
        "dmg": "controller.animation.damage",
        "look_at_target_controller": "controller.animation.humanoid.look_at_target",
        "swimming_controller": "controller.animation.humanoid.swimming",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "general": "animation.mob.stop",
        "moving": "animation.mob.walk",
        "running": "animation.mob.run",
        "jumping": "animation.mob.jump",
        "swimming": "animation.zombie.swimming"
      },
      "spawn_egg": {
        "texture": "giga_clone",
        "texture_index": 0
      },
      "render_controllers": [
        "controller.render.default",
				"controller.render.dmg"
      ],
      "enable_attachables": true
    }
  }
}
