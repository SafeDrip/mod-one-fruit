        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/entity/bosses/rayleigh_boss",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.capa_rayleigh"
      },
      "animations": {
        "c_leo": "controller.animation.capa2",
        "capa_leo": "animation.look_leopard"
      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0;",
        "animate": [
