{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "of:black_suit",
      "item": {
        "black_suit": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/entity/bosses/sanji_germa_boss",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.sanji_germa"
      },
      "animations": {
        "default_controller": "controller.animation.capa",
        "walk": "animation.capa_walk",
        "sprint": "animation.capa_run",
        "jump": "animation.capa_jump"
      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0;",
        "animate": [
          "default_controller"
        ]
      },
      "render_controllers": [
        "controller.render.suit"
      ]
    }
  }
}
