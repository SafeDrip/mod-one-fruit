{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "of:roger",
      "item": { "of:roger": "query.owner_identifier == 'minecraft:player'" },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/eyes/roger",
        "bigode_roger": "textures/eyes/bigode_roger",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.olhos",
        "bigode_roger": "geometry.bigode_roger"
      },
      "scripts": {
        "parent_setup": "variable.head_layer_visible = 0.0;"
      },
      "render_controllers": [ "controller.render.armor", "controller.render.bigode_roger" ]
    }
  }
}
