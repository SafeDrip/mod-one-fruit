{
	"format_version" : "1.20.80",
	"animation_controllers" : {
		"controller.animation.ashura" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{"00" : "query.get_equipped_item_name == 'ashura'"}
					]
				},
				"00" : {
					"animations" : ["ashura"],
					"transitions" : [
						{"default" : "query.get_equipped_item_name != 'ashura'"}
					]
				}
			}
		}
	}
}
