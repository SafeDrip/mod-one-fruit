{
    "format_version": "1.10.0",
    "animation_controllers": {
		"controller.animation.gear4": {
            "initial_state": "bound_moving",
            "states": {
                "bound_moving": {
                    "variables": {
                        "move_speed": {
                            "input": "query.modified_move_speed",
                            "remap_curve": {
                                "0.0": 0.0,
                                "0.25": 1.0
                            }
                        },
                        "is_idling": {
                            "input": "query.modified_move_speed",
                            "remap_curve": {
                                "0.0": 1.0,
                                "0.1": 0.0
                            }
                        }
                    },
                    "animations": [{
                            "bound_move": "variable.move_speed"
                        }, {
                            "bound_idle": "variable.is_idling"
                        }
                    ],
                    "transitions": [
                       {
                            "bound_fly": "!query.is_on_ground && !query.is_in_water && !query.is_wall_climbing"
                        }, {
                            "bound_attack": "query.is_on_ground && variable.attack_time && query.get_equipped_item_name == 'kong_gun'"
                        }, {
                            "kong" : "query.get_equipped_item_name == 'kong_organgun' && query.is_using_item"
                        }
                    ]
                },
				"kong" : {
					"animations" : ["kong"],
					"transitions" : [
						{"bound_moving" : "!q.is_using_item"}
					]
				},
				"bound_fly": {
                    "animations": [
                        "bound_fly"
                    ],
                    "transitions": [{
                            "bound_moving": "query.is_on_ground"
                        }
                    ]
                },
				"bound_attack": {
                    "animations": [
                        "bound_attack"
                    ],
                    "transitions": [{
                            "bound_moving": "!variable.attack_time && query.any_animation_finished"
                        }
                    ]
                }
            }
		   }
     }
}
