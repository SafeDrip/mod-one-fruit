{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.kid" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"vortex" : "query.get_equipped_item_name == 'punk_vice_v1'"
						}
					]
				},
				"vortex" : {
					"animations" : [ "vortex" ],
					"transitions" : [
						{
							"default" : "query.get_equipped_item_name != 'punk_vice_v1'"
						}
					]
				}
			}
		}
	}
}
