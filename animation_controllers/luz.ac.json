{
  "format_version": "1.8.0",
  "animation_controllers": {
		"controller.animation.luz" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"particle" : "query.get_equipped_item_name == 'light_blaze' && query.is_using_item"
						},
						{
							"particle0" : "query.get_equipped_item_name == 'shadow' && query.is_using_item"
						}
					]
				},
				"particle" : {
					"transitions" : [
						{
							"particle2" : "query.get_equipped_item_name == 'light_blaze' && query.is_using_item"
						},
						{
							"default" : "!query.is_using_item || query.get_equipped_item_name != 'light_blaze'"
						}
					],
					"particle_effects" : [
						{"effect" : "luz"}
					]
				},
				"particle2" : {
					"transitions" : [
						{
							"particle" : "query.get_equipped_item_name == 'light_blaze' && query.is_using_item"
						},
						{
							"default" : "!query.is_using_item || query.get_equipped_item_name != 'light_blaze'"
						}
					],
					"particle_effects" : [
						{"effect" : "luz"}
					]
				},


				"particle0" : {
					"transitions" : [
						{
							"particle02" : "query.get_equipped_item_name == 'shadow' && query.is_using_item"
						},
						{
							"default" : "!query.is_using_item || query.get_equipped_item_name != 'shadow'"
						}
					],
					"particle_effects" : [
						{"effect" : "shadow"}
					]
				},
				"particle02" : {
					"transitions" : [
						{
							"particle0" : "query.get_equipped_item_name == 'shadow' && query.is_using_item"
						},
						{
							"default" : "!query.is_using_item || query.get_equipped_item_name != 'shadow'"
						}
					],
					"particle_effects" : [
						{"effect" : "shadow"}
					]
				}
			}
		}
  }
}
