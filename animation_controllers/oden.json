{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.oden.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"attacking" : "variable.attack_time"
						}
					]
				},
				"attacking" : {
					"animations" : [ "attack.rotations" ],
