{
	"format_version" : "1.10.0",
	"animation_controllers": {
		"controller.animation.sword_attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
					    {"attack1":"!variable.fr && variable.attack && variable.sword_all"}
					]
				},
				"attack1": {
					"animations": [ "atk1" ],
					"blend_transition": 0.1,
					"transitions": [
					    { "attack2": "variable.attack && variable.sword_all && query.any_animation_finished" },
					    { "default": "!variable.attack && query.any_animation_finished" }
					]
				},
				"attack2": {
					"animations": [ "atk2" ],
					"blend_transition": 0.1,
					"transitions": [
					    { "attack3": "variable.attack && variable.sword_all && query.any_animation_finished" },
					    { "default": "!variable.attack && query.any_animation_finished" }
					]
				},
				"attack3": {
					"animations": [ "atk3" ],
					"blend_transition": 0.1,
					"transitions": [
					    { "attack4": "variable.attack && variable.sword_all && query.any_animation_finished" },
					    { "default": "!variable.attack && query.any_animation_finished" }
					]
				}
			}
		},
		"controller.animation.first_sword_attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
					    {"attack1":"variable.fr && variable.attack && variable.sword_all"}
					]
				},
				"attack1": {
					"animations": [ "atk1_first" ],
					"blend_transition": 0.1,
					"transitions": [
					    { "attack2": "variable.attack && variable.sword_all && query.any_animation_finished" },
					    { "default": "!variable.attack && query.any_animation_finished" }
					]
				},
				"attack2": {
					"animations": [ "atk2_first" ],
					"blend_transition": 0.1,
					"transitions": [
					    { "attack3": "variable.attack && variable.sword_all && query.any_animation_finished" },
					    { "default": "!variable.attack && query.any_animation_finished" }
					]
				},
				"attack3": {
					"animations": [ "atk3_first" ],
					"blend_transition": 0.1,
					"transitions": [
					    { "attack4": "variable.attack && variable.sword_all && query.any_animation_finished" },
					    { "default": "!variable.attack && query.any_animation_finished" }
					]
				}
			}
		}
	}
}
