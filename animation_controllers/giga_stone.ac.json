{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.giga_stone" : {
			"initial_state" : "summon",
			"states" : {
				"summon" : {
					"animations" : ["summon"],
					"transitions" : [
						{"default" : "query.any_animation_finished"}
					]
				},
				"default" : {
					"animations" : ["default"],
					"transitions" : [
						{"attack" : "query.variant == 1"},
						{"attack2" : "query.variant == 2"},
						{"walk" : "query.has_rider && query.ground_speed >= 1"}
					]
				},
				"attack" : {
					"animations" : ["attack"],
					"transitions" : [
						{"default" : "query.any_animation_finished"}
					]
				},
				"attack2" : {
					"animations" : ["attack2"],
					"transitions" : [
						{"default" : "query.any_animation_finished"}
					]
				},
				"walk" : {
					"animations" : ["walk"],
					"transitions" : [
						{"default" : "query.ground_speed < 1"}
					]
				}
			}
		}
	}
}
